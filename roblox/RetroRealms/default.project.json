{
  "name": "RetroRealms",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },
    "ServerScriptService": {
      "GameServer": {
        "$path": "src/ServerScriptService/GameServer"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/StarterPlayerScripts/Client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "Brightness": 2,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.5, 0.5, 0.5],
        "ClockTime": 14
      }
    }
  }
}
